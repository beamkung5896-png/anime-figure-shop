# ไฟล์ตั้งค่าลับของร้าน — ห้ามอัปขึ้น Git / ห้ามส่งให้ใคร
# สร้างคีย์ได้ที่ Google AI Studio -> Get API key
GEMINI_API_KEY=ใส่คีย์ของคุณที่นี่
# ตัวเลือกเสริม (ไม่ต้องใส่ก็ได้ ค่าเริ่มต้นตามนี้)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low        # low / medium / high (ว่าง = ไม่ส่งพารามิเตอร์นี้)
AI_DAILY_LIMIT=500               # จำนวนข้อความสูงสุดต่อวันทั้งร้าน (กันค่าใช้จ่ายบานปลาย)
AI_PER_IP_LIMIT=15               # ข้อความต่อ IP ต่อ 5 นาที
AI_LOG=1                         # 0 = ไม่บันทึกคำถามลูกค้า
